# Official KICK Public API
KICK_API_BASE_URL=https://api.kick.com/
# Optional for development only. Prefer the in-app OAuth flow.
KICK_API_TOKEN=

# OAuth gateway (recommended for production)
KICK_OAUTH_GATEWAY_URL=https://YOUR-WORKER.workers.dev
# KICK public client id. Never put KICK_CLIENT_SECRET in the Android app.
KICK_CLIENT_ID=
